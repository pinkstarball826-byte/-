  "scenes": [
    { "id": 1, "start": 0, "duration": 6, "narration": "人間関係で疲れる人には、ある共通点があります。", "emphasis_text": "人間関係で疲れる人",
      "elements": [
        { "type": "character", "id": "A", "position": [540, 1000], "mouth": "neutral", "motion": "popIn" },
        { "type": "icon", "name": "question", "position": [680, 760], "motion": "popIn", "delay_ms": 600 } ] },
    { "id": 2, "start": 6, "duration": 7, "narration": "それは、優しさが足りないのではなく、「境界線」が曖昧なことです。", "emphasis_text": "境界線が曖昧",
      "elements": [
        { "type": "character", "id": "A", "position": [540, 1000], "mouth": "surprised", "motion": "tiltHead" },
        { "type": "diagram", "shape": "dashed_circle", "center": [540, 1000], "radius": 380, "color": "accent", "motion": "drawLine" } ] },
    { "id": 3, "start": 13, "duration": 7, "narration": "境界線とは、自分の気持ちと、相手の気持ちの間にある、見えない線のことです。", "emphasis_text": "見えない線",
      "elements": [
        { "type": "character", "id": "A", "position": [300, 1000], "mouth": "neutral", "motion": "slideInLeft" },
        { "type": "character", "id": "B", "position": [780, 1000], "mouth": "neutral", "motion": "slideInRight" },
        { "type": "diagram", "shape": "dashed_line", "from": [540, 700], "to": [540, 1300], "color": "accent", "motion": "drawLine", "delay_ms": 800 } ] },
    { "id": 4, "start": 20, "duration": 8, "narration": "これが曖昧だと、相手の機嫌まで、自分の責任のように感じてしまいます。", "emphasis_text": "相手の機嫌＝自分の責任？",
      "elements": [
        { "type": "diagram", "shape": "venn_overlap", "centers": [[400, 1000], [680, 1000]], "radius": 280, "colors": ["accent", "ink"] },
        { "type": "character", "id": "A", "position": [400, 1000], "mouth": "sad", "motion": "headDown", "delay_ms": 500 },
        { "type": "character", "id": "B", "position": [680, 1000], "mouth": "sad", "motion": "popIn" },
        { "type": "diagram", "shape": "arrow", "from": [680, 700], "to": [400, 700], "color": "ink", "motion": "drawLine", "delay_ms": 900 } ] },
    { "id": 5, "start": 28, "duration": 7, "narration": "たとえば、友達が不機嫌だと、「私が何かしたかな」と考え込んでしまう。", "emphasis_text": "私が何かした？",
      "elements": [
        { "type": "character", "id": "B", "position": [800, 1050], "mouth": "sad", "motion": "slideInRight" },
        { "type": "character", "id": "A", "position": [300, 1050], "mouth": "sad", "motion": "tiltHead" },
        { "type": "icon", "name": "question", "position": [260, 700], "motion": "popIn", "delay_ms": 500 },
        { "type": "icon", "name": "question", "position": [380, 640], "motion": "popIn", "delay_ms": 900 } ] },
    { "id": 6, "start": 35, "duration": 7, "narration": "でも、相手の気分は、相手の課題。あなたの課題ではありません。", "emphasis_text": "相手の気分は相手の課題",
      "elements": [
        { "type": "diagram", "shape": "circle", "center": [300, 1000], "radius": 240, "color": "accent" },
        { "type": "diagram", "shape": "circle", "center": [780, 1000], "radius": 240, "color": "ink" },
        { "type": "diagram", "shape": "label", "text": "自分の課題", "position": [300, 1330], "color": "accent" },
        { "type": "diagram", "shape": "label", "text": "相手の課題", "position": [780, 1330], "color": "ink" },
        { "type": "character", "id": "A", "position": [300, 1000], "mouth": "neutral", "scale": 0.7, "motion": "popIn" },
        { "type": "character", "id": "B", "position": [780, 1000], "mouth": "sad", "scale": 0.7, "motion": "popIn", "delay_ms": 300 } ] },
    { "id": 7, "start": 42, "duration": 6, "narration": "心理学では、これを「課題の分離」と呼びます。", "emphasis_text": "課題の分離",
      "elements": [
        { "type": "icon", "name": "brain", "position": [540, 900], "scale": 1.5, "motion": "popIn" },
        { "type": "diagram", "shape": "label", "text": "課題の分離", "position": [540, 1250], "size": 110, "color": "accent", "motion": "zoomIn" } ] },
    { "id": 8, "start": 48, "duration": 8, "narration": "やり方は簡単。迷ったら、「これは、誰の問題？」と自分に聞くだけです。", "emphasis_text": "これは誰の問題？",
      "elements": [
        { "type": "character", "id": "A", "position": [540, 1050], "mouth": "neutral", "motion": "tiltHead" },
        { "type": "icon", "name": "question", "position": [700, 720], "scale": 1.4, "motion": "popIn", "delay_ms": 500 } ] },
    { "id": 9, "start": 56, "duration": 7, "narration": "自分の問題なら行動する。相手の問題なら、手放す。", "emphasis_text": "自分なら行動／相手なら手放す",
      "elements": [
        { "type": "diagram", "shape": "arrow", "from": [540, 800], "to": [300, 1100], "color": "accent", "motion": "drawLine" },
        { "type": "diagram", "shape": "arrow", "from": [540, 800], "to": [780, 1100], "color": "ink", "motion": "drawLine", "delay_ms": 600 },
        { "type": "diagram", "shape": "label", "text": "行動する", "position": [300, 1200], "color": "accent" },
        { "type": "diagram", "shape": "label", "text": "手放す", "position": [780, 1200], "color": "ink" },
        { "type": "icon", "name": "check", "position": [300, 1330], "motion": "popIn", "delay_ms": 1200 } ] },
    { "id": 10, "start": 63, "duration": 7, "narration": "距離をとるのは、冷たさじゃない。長く付き合うための、優しさです。", "emphasis_text": "距離は優しさ",
      "elements": [
        { "type": "character", "id": "A", "position": [260, 1000], "mouth": "happy", "motion": "bounce" },
        { "type": "character", "id": "B", "position": [820, 1000], "mouth": "happy", "motion": "bounce", "delay_ms": 200 },
        { "type": "diagram", "shape": "dashed_line", "from": [380, 1000], "to": [700, 1000], "color": "accent", "motion": "drawLine" } ] },
    { "id": 11, "start": 70, "duration": 5, "narration": "次回は、「断れない人の心理」を解説します。", "emphasis_text": "次回：断れない人の心理",
      "elements": [
        { "type": "character", "id": "A", "position": [540, 1000], "mouth": "neutral", "motion": "nod" },
        { "type": "icon", "name": "exclaim", "position": [700, 760], "motion": "popIn", "delay_ms": 400 } ] }
  ],
